{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.local/schemas/project-v1.schema.json",
  "title": "Meridian project declaration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {"const": 1},
    "project": {"type": "object", "additionalProperties": false, "required": ["name", "slug"], "properties": {"name": {"type": "string", "minLength": 1}, "slug": {"type": "string", "minLength": 1}}},
    "locations": {"type": "object", "additionalProperties": false, "properties": {"queue": {"$ref": "#/$defs/path"}, "taskRoots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path"}}, "reviewRoot": {"$ref": "#/$defs/path"}, "handoffRoot": {"$ref": "#/$defs/path"}, "adrLog": {"$ref": "#/$defs/path"}, "plan": {"$ref": "#/$defs/path"}}},
    "validationScoping": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["paths", "commands"], "properties": {"paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}},
    "ci": {"oneOf": [{"const": "none"}, {"type": "object", "additionalProperties": false, "required": ["provider", "requiredChecks"], "properties": {"provider": {"type": "string", "minLength": 1}, "requiredChecks": {"type": "array", "items": {"type": "string", "minLength": 1}}}}]}
  },
  "$defs": {"path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}}
}
