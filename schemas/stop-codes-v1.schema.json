{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.local/schemas/stop-codes-v1.schema.json",
  "title": "Meridian stop-code registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "stops"],
  "properties": {
    "version": {"const": 1},
    "stops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "class", "kind", "workflows", "emitter", "human_decision", "resume", "summary"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "class": {"enum": ["tool", "command-exit", "judgment"]},
          "kind": {"enum": ["stop", "status"]},
          "workflows": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["lean-delivery", "governed-sdd"]}
          },
          "step": {"type": "string", "pattern": "^C[0-9]+$"},
          "emitter": {"type": "string", "minLength": 1},
          "human_decision": {"type": "boolean"},
          "resume": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "tool_hint": {"type": "string", "minLength": 1},
          "test": {"type": "string", "pattern": "^tests\\.[A-Za-z0-9_.]+$"}
        },
        "allOf": [
          {"if": {"properties": {"class": {"const": "tool"}, "kind": {"const": "stop"}}},
           "then": {"required": ["test"]}}
        ]
      }
    }
  }
}
