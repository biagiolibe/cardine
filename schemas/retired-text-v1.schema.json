{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.local/schemas/retired-text-v1.schema.json",
  "title": "Meridian retired project-owned text registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "retirements"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "retirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "retiredIn",
          "phrases",
          "files",
          "remedy"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "retiredIn": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "remedy": {
            "type": "string",
            "minLength": 1
          },
          "phrases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!tasks/)[^\\\\]+$"
            }
          }
        }
      }
    }
  }
}
